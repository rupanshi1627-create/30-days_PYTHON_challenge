        "max_water = 0 # This variable will store the maximum water found\n",
        "left = 0\n",
        "right = len(height_list)-1\n",
        "\n",
        "while left < right:\n",
        "    # Calculate width between the two pointers\n",
        "    width = right - left\n",
        "\n",
        "    # The height of the container is limited by the shorter of the two lines\n",
        "    current_container_height = min(height_list[left], height_list[right])\n",
        "\n",
        "    # Calculate the water that can be contained by the current pair of lines\n",
        "    current_water = current_container_height * width\n",
        "\n",
        "    # Update max_water if the current container holds more water\n",
        "    max_water = max(max_water, current_water)\n",
        "\n",
        "    # Move the pointer of the shorter line inwards\n",
        "    # Moving the shorter line has the potential to increase the container's height\n",
        "    if height_list[left] < height_list[right]:\n",
        "        left += 1 # Corrected: Use '+=' to update the left pointer\n",
        "    else:\n",
        "        right -= 1\n",
        "\n",
