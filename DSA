      "source": [
        "nums=[1,1,2,2,3,7,6,8,8,9,10]\n",
        "\n",
        "# For the two-pointer technique to remove duplicates in-place\n",
        "# and efficiently, the array is typically assumed to be sorted.\n",
        "# Let's sort the array first for demonstration purposes.\n",
        "nums.sort()\n",
        "print(\"Sorted nums array:\", nums)\n",
        "\n",
        "# Initialize two pointers:\n",
        "# 'i' (slow-runner) will keep track of the last unique element found and its correct position.\n",
        "# 'j' (fast-runner) will iterate through the array to find new unique elements.\n",
        "\n",
        "if not nums: # Handle the edge case of an empty list\n",
        "    k = 0\n",
        "else:\n",
        "    i = 0 # 'i' starts at the first element (index 0), which is always unique initially\n",
        "    for j in range(1, len(nums)): # 'j' starts from the second element (index 1)\n",
        "        # If the element at 'j' is different from the element at 'i',\n",
        "        # it means we found a new unique element.\n",
        "        if nums[j] != nums[i]:\n",
        "            i += 1          # Move 'i' forward to the next position\n",
        "            nums[i] = nums[j] # Place the new unique element at `nums[i]`\n",
        "    # After the loop, 'i' points to the last unique element's index.\n",
        "    # So, 'i + 1' gives the total number of unique elements (k).\n",
        "    k = i + 1\n",
        "\n",
        "# The first 'k' elements of the 'nums' array now contain the unique elements.\n",
        "# The remaining elements beyond index 'k-1' are duplicates and are effectively 'removed'\n",
        "# by defining the new length 'k'.\n",
        "print(\"Array after removing duplicates (first k elements are unique):\", nums[:k])\n",
        "print(\"Number of unique elements (k):\", k)"
