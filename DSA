        "numbers=[1,0,3,0,0,2,0]\n",
        "\n",
        "pos=0\n",
        "# 'pos' ek counter/pointer hai jo track karta hai ki\n",
        "# agla non-zero number array mein KAHAN likhna hai.\n",
        "# Ye hamesha sirf AAGE (left se right) hi badhta hai, kabhi peeche nahi jaata —\n",
        "# isliye ise \"same-direction pointer\" kehte hain.\n",
        "for num in numbers:\n",
        "  if num!=0:\n",
        "    numbers[pos]=num\n",
        "    pos+=1\n",
        "# Agar num zero hai, toh if block ke andar kuch nahi hota —\n",
        "    # loop apne aap agle number pe chala jaata hai (num update ho jaata hai),\n",
        "    # lekin 'pos' apni jagah RUKA rehta hai, kyunki wahan ek \"khali slot\" hai\n",
        "    # jo baad mein kisi non-zero number se ya phir zero se bharna hai\n",
        "# Is point tak, array ke SHURU mein saare non-zero numbers\n",
        "# apne sahi, original order mein aa chuke hain.\n",
        "# Lekin array ke BAAKI bache hue positions (pos se end tak)\n",
        "# abhi bhi PURANI (duplicate) values rakhte hain —\n",
